{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "cwd":"${fileDirname}",
            "program": "${file}",
            "console": "integratedTerminal"
        },      
        {
            "name": "Debug Cartpole_PPO",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/export_system/exports/Cartpole_PPO/runner.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/export_system/exports/Cartpole_PPO",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
                "DNNE_ISAAC_GYM": "/home/asantanna/DNNE-LINUX-SUPPORT/isaacgym",
                "DNNE_ISAAC_GYM_ENVS": "/home/asantanna/DNNE-LINUX-SUPPORT/IsaacGymEnvs",
                "DNNE_LINUX_SUPPORT": "/home/asantanna/DNNE-LINUX-SUPPORT",
                "DNNE_RL_GAMES": "/home/asantanna/DNNE-LINUX-SUPPORT/rl_games_dnne",
                "HYDRA_FULL_ERROR": "1"
            },
            "args": [
                "--verbose",
                "--test-mode"
            ],
            "justMyCode": false,
            "subProcess": true,
            "python": "/home/asantanna/miniconda/envs/DNNE_PY38/bin/python"
        },
        {
            "name": "Debug Yield_Test (Headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/export_system/exports/Yield_Test/runner.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/export_system/exports/Yield_Test",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
                "DNNE_ISAAC_GYM": "/home/asantanna/DNNE-LINUX-SUPPORT/isaacgym",
                "DNNE_ISAAC_GYM_ENVS": "/home/asantanna/DNNE-LINUX-SUPPORT/IsaacGymEnvs",
                "DNNE_LINUX_SUPPORT": "/home/asantanna/DNNE-LINUX-SUPPORT",
                "DNNE_RL_GAMES": "/home/asantanna/DNNE-LINUX-SUPPORT/rl_games_dnne",
                "HYDRA_FULL_ERROR": "1"
            },
            "args": [
                "--headless",
                "--timeout",
                "1m"
            ],
            "justMyCode": false,
            "subProcess": true,
            "python": "/home/asantanna/miniconda/envs/DNNE_PY38/bin/python"
        },
        {
            "name": "Debug Cartpole_PPO (Headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/export_system/exports/Cartpole_PPO/runner.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/export_system/exports/Cartpole_PPO",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
                "DNNE_ISAAC_GYM": "/home/asantanna/DNNE-LINUX-SUPPORT/isaacgym",
                "DNNE_ISAAC_GYM_ENVS": "/home/asantanna/DNNE-LINUX-SUPPORT/IsaacGymEnvs",
                "DNNE_LINUX_SUPPORT": "/home/asantanna/DNNE-LINUX-SUPPORT",
                "DNNE_RL_GAMES": "/home/asantanna/DNNE-LINUX-SUPPORT/rl_games_dnne",
                "HYDRA_FULL_ERROR": "1"
            },
            "args": [
                "--headless",
                "--timeout",
                "1m"
            ],
            "justMyCode": false,
            "subProcess": true,
            "python": "/home/asantanna/miniconda/envs/DNNE_PY38/bin/python"
        },
        {
            "name": "Windows: Debug DNNE Server",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "args": ["--front-end-root", "../DNNE-UI-Frontend/dist", "--listen", "0.0.0.0", "--agent-server-terminal"],
            "console": "integratedTerminal"
        },
    ]
}