# DNNE UI MCP Server Configuration

# DNNE Server URL (default for WSL2 to Windows)
DNNE_URL=http://172.22.160.1:8188

# Browser settings
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000

# Logging
LOG_LEVEL=INFO

# Screenshot directory
SCREENSHOT_DIR=./screenshots

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1000