{
  "layout": {
    "columns": 2,
    "dialogWidth": "900px",
    "dialogMaxHeight": "80vh"
  },
  "arguments": {
    "logging": {
      "switch": "--verbose",
      "type": "select",
      "label": "Logging Level",
      "description": "Set logging verbosity",
      "options": ["off", "INFO", "DEBUG"],
      "default": "off",
      "column": 1,
      "order": 1
    },
    "load_checkpoint": {
      "switch": "--load-checkpoint",
      "type": "text",
      "label": "Load Checkpoint",
      "description": "Directory to load checkpoints from",
      "placeholder": "path/to/checkpoint",
      "label_on_same_line": false,
      "column": 1,
      "order": 2
    },
    "save_checkpoint": {
      "switch": "--save-checkpoint",
      "type": "checkbox",
      "label": "Save Checkpoints",
      "description": "Enable checkpoint saving during training",
      "column": 1,
      "order": 3
    },
    "out_dir": {
      "switch": "--out-dir",
      "type": "text",
      "label": "Output Directory",
      "description": "Directory for checkpoints and other outputs",
      "placeholder": "runs/singles",
      "label_on_same_line": false,
      "column": 1,
      "order": 4
    },
    "timeout": {
      "switch": "--timeout",
      "type": "text",
      "label": "Timeout",
      "description": "Training duration",
      "placeholder": "e.g., 30s, 5m, 1h30m",
      "column": 1,
      "order": 5
    },
    "inference": {
      "switch": "--inference",
      "type": "checkbox",
      "label": "Inference Mode",
      "description": "Run in inference mode (no training, no gradients)",
      "column": 1,
      "order": 6
    },
    "visual": {
      "switch": "--visual",
      "type": "checkbox",
      "label": "Show Simulator",
      "description": "Enable visual mode to show simulator window",
      "column": 1,
      "order": 7
    },
    "heartbeat": {
      "switch": "--heartbeat",
      "type": "checkbox",
      "label": "Heartbeat Monitor",
      "description": "Enable heartbeat monitoring with deadlock detection",
      "column": 1,
      "order": 8
    },
    "debug_deadlock": {
      "switch": "--debug-deadlock",
      "type": "checkbox",
      "label": "Debug Deadlock",
      "description": "Collect deadlock data for offline analysis",
      "column": 1,
      "order": 9
    },
    "epochs": {
      "switch": "--epochs",
      "type": "text",
      "label": "Epochs",
      "description": "Override max epochs for EpochTracker nodes",
      "placeholder": "e.g., 10 or 55:10,56:20",
      "column": 2,
      "order": 1
    },
    "max_iterations": {
      "switch": "--max-iterations",
      "type": "text",
      "label": "Max Iterations",
      "description": "Override max iterations for PPOAgent nodes",
      "placeholder": "e.g., 1000 or 66:5000",
      "column": 2,
      "order": 2
    },
    "learning_rate": {
      "switch": "--learning-rate",
      "type": "text",
      "label": "Learning Rate",
      "description": "Override learning rate for SGDOptimizer nodes",
      "placeholder": "e.g., 0.01 or 68:0.001",
      "column": 2,
      "order": 3
    },
    "batch_size": {
      "switch": "--batch-size",
      "type": "text",
      "label": "Batch Size",
      "description": "Override batch size for BatchSampler nodes",
      "placeholder": "e.g., 32 or 38:64",
      "column": 2,
      "order": 4
    },
    "fixed_seed": {
      "switch": "--fixed-seed",
      "type": "number",
      "label": "Fixed Seed",
      "description": "Use fixed random seed for deterministic execution",
      "placeholder": "e.g., 42",
      "column": 2,
      "order": 5
    },
    "enable_telemetry": {
      "switch": "--enable-telemetry",
      "type": "select_or_text",
      "label": "Enable Telemetry",
      "description": "Enable telemetry reporting for nodes or subsystems",
      "options": ["all", "custom"],
      "placeholder": "e.g., training,10,11 or rl",
      "column": 2,
      "order": 6
    },
    "override": {
      "switch": "--override",
      "type": "text",
      "label": "Advanced Overrides",
      "description": "Override node configuration values. Can be used multiple times.",
      "placeholder": "e.g., 56:checkpoint_enabled=True or training:lr=0.001",
      "label_on_same_line": false,
      "column": 2,
      "order": 7,
      "multiple": true
    }
  },
  "argument_order": [
    "logging",
    "load_checkpoint",
    "save_checkpoint",
    "out_dir",
    "timeout",
    "inference",
    "visual",
    "heartbeat",
    "debug_deadlock",
    "epochs",
    "max_iterations",
    "learning_rate",
    "batch_size",
    "fixed_seed",
    "enable_telemetry",
    "override"
  ]
}